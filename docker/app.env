# Settings for the containerised app (web and scheduler). Edit this file, then `docker compose up -d` again.
# Plain KEY=value lines, no quotes needed. Every value here is the default, shown so you can change it.
# Anything not listed uses the application default (see docs/INSTALL.md, "Environment variable reference").

# ── first admin ─────────────────────────────────────────────────────────
# Created on first start if it doesn't exist. With no password, a random one is generated and printed ONCE in
# `docker compose logs web`. An existing account is never changed.
JOBMCP_ADMIN_EMAIL=admin@example.com
JOBMCP_ADMIN_PASSWORD=

# ── address ─────────────────────────────────────────────────────────────
# Used in emailed links and in the agent setup commands in the portal. Set to your public https:// address.
JOBMCP_PUBLIC_BASE_URL=http://localhost:8000
# 1 only when a reverse proxy you control sits in front and sets X-Forwarded-For.
JOBMCP_TRUST_PROXY=0

# ── email ───────────────────────────────────────────────────────────────
# console: nothing is sent; verification and reset links are printed in `docker compose logs web`.
# For real email use smtp and fill in the SMTP values (then also set JOBMCP_MAIL_FROM).
JOBMCP_MAIL_BACKEND=console
JOBMCP_MAIL_FROM=jobmcp <no-reply@localhost>
JOBMCP_SMTP_HOST=localhost
JOBMCP_SMTP_PORT=587
JOBMCP_SMTP_USER=
JOBMCP_SMTP_PASSWORD=
JOBMCP_SMTP_SECURITY=starttls
# 0 skips email confirmation of new accounts (e.g. when there is no mail server).
JOBMCP_REQUIRE_EMAIL_VERIFICATION=1
JOBMCP_ALLOW_REGISTRATION=1

# ── logging ─────────────────────────────────────────────────────────────
# Everything is written to stdout/stderr, so `docker compose logs -f` (or `container logs`) shows it.
# DEBUG | INFO | WARNING | ERROR. Per-logger overrides, e.g. JOBMCP_LOG_LEVELS=jobmcp.sync=DEBUG,jobmcp.http=DEBUG
JOBMCP_LOG_LEVEL=INFO
# text, or json (one object per line, for a log shipper)
JOBMCP_LOG_FORMAT=text
JOBMCP_LOG_LEVELS=

# ── syncing ─────────────────────────────────────────────────────────────
JOBMCP_SYNC_INTERVAL_MIN=60

# ── metrics ─────────────────────────────────────────────────────────────
# Through the published port /metrics is refused unless a token is set and sent as a bearer token:
#   curl -H "Authorization: Bearer <token>" http://localhost:8000/metrics
JOBMCP_METRICS_TOKEN=
