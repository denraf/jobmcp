[Unit]
Description=livejobs sync worker (alternative to the hourly timer/cron: a daemon that syncs boards as they come due)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=livejobs
Group=livejobs
WorkingDirectory=/opt/livejobs
EnvironmentFile=/etc/livejobs/livejobs.env
ExecStart=/opt/livejobs/.venv/bin/livejobs worker --workers 8
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
