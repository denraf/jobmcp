[Unit]
Description=jobmcp task worker: does what the admin portal queues (board imports, syncs, platform check, Common Crawl refresh)
Documentation=file:///opt/jobmcp/docs/INSTALL.md
After=network-online.target mysql.service jobmcp-web.service
Wants=network-online.target

[Service]
Type=simple
User=jobmcp
Group=jobmcp
WorkingDirectory=/opt/jobmcp
EnvironmentFile=/etc/jobmcp/jobmcp.env
# The web service only queues this work (rows in the `tasks` table) and shows its progress; this process does it, so
# a huge import or a sync of every board never slows the pages down. Safe to run on a different machine from the web
# service, as long as it reaches the same database.
ExecStart=/opt/jobmcp/.venv/bin/jobmcp tasks
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
