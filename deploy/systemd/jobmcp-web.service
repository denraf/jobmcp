[Unit]
Description=jobmcp web (site, REST API and MCP endpoint)
Documentation=file:///opt/jobmcp/docs/INSTALL.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=jobmcp
Group=jobmcp
WorkingDirectory=/opt/jobmcp
EnvironmentFile=/etc/jobmcp/jobmcp.env
ExecStart=/opt/jobmcp/.venv/bin/jobmcp serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Hardening: the web process needs the network and nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
