[Unit]
Description=livejobs scheduler: hourly job fetch, monthly Common Crawl refresh, daily platform check
Documentation=file:///opt/livejobs/docs/INSTALL.md
After=network-online.target mysql.service livejobs-web.service
Wants=network-online.target

[Service]
Type=simple
User=livejobs
Group=livejobs
WorkingDirectory=/opt/livejobs
EnvironmentFile=/etc/livejobs/livejobs.env
# One process runs everything recurring: it fetches due boards every hour (and records the daily per-platform counts),
# refreshes the Common Crawl inventory monthly, and runs the platform canary daily at 05:30 UTC. It uses a database
# lock, so a second copy (or a manual `inventory --refresh`) never overlaps it.
ExecStart=/opt/livejobs/.venv/bin/livejobs scheduler
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
