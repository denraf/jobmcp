[Unit]
Description=jobmcp scheduler: hourly job fetch, monthly Common Crawl refresh, daily platform check
Documentation=file:///opt/jobmcp/docs/INSTALL.md
After=network-online.target mysql.service jobmcp-web.service
Wants=network-online.target

[Service]
Type=simple
User=jobmcp
Group=jobmcp
WorkingDirectory=/opt/jobmcp
EnvironmentFile=/etc/jobmcp/jobmcp.env
# One process runs everything recurring: it fetches due boards every hour (and records the daily per-platform counts),
# refreshes the Common Crawl inventory monthly, and runs the platform canary daily at 05:30 UTC. It uses a database
# lock, so a second copy (or a manual `inventory --refresh`) never overlaps it.
ExecStart=/opt/jobmcp/.venv/bin/jobmcp scheduler
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
