# /etc/cron.d/jobmcp-backup : nightly database backup at 03:15 (see deploy/bin/jobmcp-backup.sh).
# Use this with the jobmcp-scheduler service. (deploy/cron/jobmcp is the all-cron alternative to the scheduler.)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

15    3    *   *   *    jobmcp  /opt/jobmcp/deploy/bin/jobmcp-backup.sh >> /var/log/jobmcp/backup.log 2>&1
