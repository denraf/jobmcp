#!/usr/bin/env bash
# Run any `livejobs` command with the production environment loaded:
#   sudo -u livejobs /opt/livejobs/deploy/bin/livejobs-admin boards stats
set -euo pipefail
ENV_FILE="${LIVEJOBS_ENV_FILE:-/etc/livejobs/livejobs.env}"
APP_DIR="${LIVEJOBS_APP_DIR:-/opt/livejobs}"
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a
exec "$APP_DIR/.venv/bin/livejobs" "$@"
