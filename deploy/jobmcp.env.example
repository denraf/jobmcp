# /etc/jobmcp/jobmcp.env
#
# Read by systemd (EnvironmentFile=) and by deploy/bin/jobmcp-cron-sync.sh (sourced by bash), so keep it
# plain KEY='value' lines: single quotes around values, and no $ or ' characters inside a value.
# Permissions: chmod 640, owner root, group jobmcp  (it holds secrets).

# ── database ────────────────────────────────────────────────────────────
# Use letters and digits in the password (e.g. `openssl rand -hex 24`); it sits inside a URL.
JOBMCP_DATABASE_URL='mysql+pymysql://jobmcp:CHANGE_ME@127.0.0.1:3306/jobmcp?charset=utf8mb4'

# ── public address ──────────────────────────────────────────────────────
# Used in emailed links and in the agent setup commands shown in the portal. Must be your real https:// address.
JOBMCP_PUBLIC_BASE_URL='https://jobmcp.ai'
# Yes when running behind Caddy/nginx on the same machine (reads the real client IP for rate limiting).
JOBMCP_TRUST_PROXY=1

# ── email (required: signups confirm their address by link) ─────────────
JOBMCP_MAIL_BACKEND='smtp'
JOBMCP_MAIL_FROM='jobmcp <no-reply@jobmcp.ai>'
JOBMCP_SMTP_HOST='smtp.example.com'
JOBMCP_SMTP_PORT=587
JOBMCP_SMTP_USER='CHANGE_ME'
JOBMCP_SMTP_PASSWORD='CHANGE_ME'
JOBMCP_SMTP_SECURITY='starttls'      # starttls (port 587) | ssl (port 465) | none
# No mail server at all? Uncomment to let people in without confirming their address (and use admin resets):
# JOBMCP_REQUIRE_EMAIL_VERIFICATION=0

# ── signup ──────────────────────────────────────────────────────────────
JOBMCP_ALLOW_REGISTRATION=1
JOBMCP_AUTH_RATE_PER_MIN=10

# ── syncing ─────────────────────────────────────────────────────────────
# How often each board is refreshed. The hourly cron/timer picks up whatever is due.
JOBMCP_SYNC_INTERVAL_MIN=60

# ── metrics ─────────────────────────────────────────────────────────────
# /metrics is open to 127.0.0.1 only (and never through the proxy). To scrape from another machine,
# set a token and send it as `Authorization: Bearer <token>`.
# JOBMCP_METRICS_TOKEN='CHANGE_ME'
