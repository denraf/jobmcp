# Managed by Ansible. The livejobs site for {{ livejobs_domain }}; the app listens on 127.0.0.1:{{ livejobs_port }}.
<VirtualHost *:80>
    ServerName {{ livejobs_domain }}
    ErrorLog ${APACHE_LOG_DIR}/livejobs-error.log
    CustomLog ${APACHE_LOG_DIR}/livejobs-access.log combined
{% if tls_ready %}
    # Everything but the certificate challenge goes to HTTPS.
    RewriteEngine on
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
{% endif %}
</VirtualHost>
{% if tls_ready %}

<VirtualHost *:443>
    ServerName {{ livejobs_domain }}
    ErrorLog ${APACHE_LOG_DIR}/livejobs-error.log
    CustomLog ${APACHE_LOG_DIR}/livejobs-access.log combined

    SSLEngine on
    SSLCertificateFile {{ apache_cert_file }}
    SSLCertificateKeyFile {{ apache_key_file }}
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    Header always set Strict-Transport-Security "max-age=31536000"

    # Reverse proxy. ProxyRequests stays off (the default): this is not a forward proxy.
    ProxyPreserveHost On

    # The client address. livejobs trusts the FIRST entry of X-Forwarded-For for its login rate limit, and Apache's
    # own header handling would keep whatever the client sent in front of the real address. So switch that off and
    # set the header from the connection itself: a client-supplied value can never survive.
    ProxyAddHeaders Off
    SetEnvIf Remote_Addr "^(.*)$" LIVEJOBS_CLIENT_IP=$1
    RequestHeader set X-Forwarded-For "%{LIVEJOBS_CLIENT_IP}e"
    RequestHeader set X-Forwarded-Proto "https"

    # Metrics are for Prometheus on this machine only; never serve them to the internet.
    ProxyPass "/metrics" "!"
    RedirectMatch 404 "^/metrics(/.*)?$"

    # flushpackets: MCP over streamable HTTP streams its responses. The long timeout is for slow searches.
    ProxyPass "/" "http://127.0.0.1:{{ livejobs_port }}/" flushpackets=on timeout=300
    ProxyPassReverse "/" "http://127.0.0.1:{{ livejobs_port }}/"

    LimitRequestBody 1048576
</VirtualHost>
{% endif %}
