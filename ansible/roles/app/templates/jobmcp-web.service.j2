# Managed by Ansible.
[Unit]
Description=jobmcp web (site, REST API and MCP endpoint)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ jobmcp_user }}
Group={{ jobmcp_user }}
WorkingDirectory={{ jobmcp_app_dir }}
EnvironmentFile=/etc/jobmcp/jobmcp.env
ExecStart={{ jobmcp_app_dir }}/.venv/bin/jobmcp serve --host 127.0.0.1 --port {{ jobmcp_port }}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
