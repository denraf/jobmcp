# Managed by Ansible.
[Unit]
Description=livejobs scheduler (hourly job fetch, monthly Common Crawl refresh, daily platform check)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ livejobs_user }}
Group={{ livejobs_user }}
WorkingDirectory={{ livejobs_app_dir }}
EnvironmentFile=/etc/livejobs/livejobs.env
ExecStart={{ livejobs_app_dir }}/.venv/bin/livejobs scheduler
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
