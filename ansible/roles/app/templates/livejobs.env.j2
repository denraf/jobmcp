# Managed by Ansible. Read by systemd (EnvironmentFile=) and by deploy/bin/livejobs-admin (sourced by bash), so every
# line stays KEY='value' with no $ or ' inside a value.
LIVEJOBS_DATABASE_URL='mysql+pymysql://{{ db_user }}:{{ vault_db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?charset=utf8mb4'
LIVEJOBS_PUBLIC_BASE_URL='https://{{ livejobs_domain }}'
# Apache is in front and sets X-Forwarded-For itself (see the vhost), so the real client IP can be trusted.
LIVEJOBS_TRUST_PROXY=1
LIVEJOBS_MAIL_BACKEND='smtp'
LIVEJOBS_MAIL_FROM='{{ mail_from }}'
LIVEJOBS_SMTP_HOST='{{ smtp_host }}'
LIVEJOBS_SMTP_PORT={{ smtp_port }}
LIVEJOBS_SMTP_USER='{{ smtp_user }}'
LIVEJOBS_SMTP_PASSWORD='{{ vault_smtp_password }}'
LIVEJOBS_SMTP_SECURITY='{{ smtp_security }}'
LIVEJOBS_ALLOW_REGISTRATION={{ livejobs_allow_registration }}
{% for key, value in livejobs_env_extra.items() %}
LIVEJOBS_{{ key }}='{{ value }}'
{% endfor %}
