# Managed by Ansible. Read by systemd (EnvironmentFile=) and by deploy/bin/jobmcp-admin (sourced by bash), so every
# line stays KEY='value' with no $ or ' inside a value.
JOBMCP_DATABASE_URL='mysql+pymysql://{{ db_user }}:{{ vault_db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?charset=utf8mb4'
JOBMCP_PUBLIC_BASE_URL='https://{{ jobmcp_domain }}'
# Apache is in front and sets X-Forwarded-For itself (see the vhost), so the real client IP can be trusted.
JOBMCP_TRUST_PROXY=1
JOBMCP_MAIL_BACKEND='smtp'
JOBMCP_MAIL_FROM='{{ mail_from }}'
JOBMCP_SMTP_HOST='{{ smtp_host }}'
JOBMCP_SMTP_PORT={{ smtp_port }}
JOBMCP_SMTP_USER='{{ smtp_user }}'
JOBMCP_SMTP_PASSWORD='{{ vault_smtp_password }}'
JOBMCP_SMTP_SECURITY='{{ smtp_security }}'
JOBMCP_ALLOW_REGISTRATION={{ jobmcp_allow_registration }}
{% for key, value in jobmcp_env_extra.items() %}
JOBMCP_{{ key }}='{{ value }}'
{% endfor %}
